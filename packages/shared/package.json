{
  "name": "@reaatech/mcp-catalog-shared",
  "description": "Shared TypeScript types and Zod validation schemas for the MCP Catalog monorepo",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/mcp-catalog.git"
  },
  "homepage": "https://github.com/reaatech/mcp-catalog/tree/main/packages/shared",
  "bugs": {
    "url": "https://github.com/reaatech/mcp-catalog/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./schemas": {
      "import": "./dist/schemas/index.js",
      "types": "./dist/schemas/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "zod": "^3.22.0"
  }
}
