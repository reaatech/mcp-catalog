# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL=postgresql://mcp_catalog:mcp_catalog@localhost:5432/mcp_catalog

# JWT
JWT_SECRET=REPLACE_WITH_A_STRONG_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# API Keys
API_KEY_HASH_ROUNDS=12

# Health Monitoring
HEALTH_CHECK_INTERVAL=60
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# Trust Proxy (set to "true" when behind reverse proxy like nginx, Docker, K8s)
TRUST_PROXY=false

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Search
SEARCH_PAGE_SIZE=20
SEARCH_MAX_RESULTS=1000

# MCP Server
CATALOG_API_URL=http://localhost:3000
CATALOG_API_KEY=
CATALOG_REQUEST_TIMEOUT=15000
